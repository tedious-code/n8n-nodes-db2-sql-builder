{
  "name": "n8n-nodes-db2-sql-builder",
  "version": "0.1.1",
  "description": "IBM Db2 SQL Builder for n8n powered by @foxschema/core — Docker/self-hosted only (ibm_db). Not installable via n8n Community Nodes / npm UI.",
  "keywords": [
    "n8n-community-node-package",
    "n8n-community-node",
    "IbmDb2",
    "db2",
    "foxschema",
    "sql",
    "sqlbuilder",
    "docker",
    "workflow"
  ],
  "license": "MIT",
  "author": {
    "name": "Huy Phan",
    "email": "huyplb@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tedious-code/n8n-nodes-db2-sql-builder.git"
  },
  "engines": {
    "node": ">=22 <=24",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "bundle:foxschema": "node scripts/bundle-foxschema.mjs",
    "build": "pnpm run bundle:foxschema && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "test": "pnpm run bundle:foxschema && tsc --noEmit && node --import tsx --test test/**/*.test.ts",
    "validate:n8n": "node scripts/validate-n8n-package.mjs"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/IbmDb2OdbcCredentialsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Db2SQLBuilder.node.js"
    ]
  },
  "dependencies": {
    "ibm_db": "^4.0.1"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "esbuild": "^0.25.0",
    "gulp": "^5.0.1",
    "n8n-workflow": "^2.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  }
}
